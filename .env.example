# =============================================================================
# VARIABLES DE ENTORNO - TICKETSYSTEM BACKEND (FASTAPI + POSTGRESQL + REDIS)
# =============================================================================

PROJECT_NAME=ConfyTickets
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Seguridad JWT y Hashing Bcrypt
SECRET_KEY=confy_super_secret_jwt_key_change_in_production_2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Base de Datos PostgreSQL 15 (AsyncPG)
POSTGRES_USER=confy_admin
POSTGRES_PASSWORD=confy_secure_password_2026
POSTGRES_DB=confytickets_db
DATABASE_URL=postgresql+asyncpg://confy_admin:confy_secure_password_2026@localhost:5439/confytickets_db

# Redis 7 (Rate Limiting Anti-DDoS, Bloqueo Fuerza Bruta y Códigos OTP)
REDIS_URL=redis://localhost:6389/0

# Servidor SMTP para Envío de Códigos OTP de Recuperación de Contraseña (Opcional en Dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@confytickets.co
